# Copy to backend/.env and fill in. Never commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=coe_school
DB_USER=coe_user
DB_PASSWORD=SchoolSecure2026
DB_HOST=127.0.0.1
DB_PORT=5432

# Only needed if the React app is served from a different origin than the API.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set True in production behind HTTPS (secure cookies, HTTPS redirect, HSTS).
DJANGO_SECURE_COOKIES=False

# Production: folder for the uploaded logo (mount a persistent disk here).
# MEDIA_ROOT=/data/media

# Optional: used by `python manage.py create_admin` (otherwise it prompts).
# Remove ADMIN_PASSWORD from this file after the admin is created.
ADMIN_UID=
ADMIN_PASSWORD=
